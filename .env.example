# Copy to .env for local runs, or add each as a GitHub Actions secret.

# Claude writes the script, captions and hashtags. Without it, a plain
# headline-based script is used.
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (the API will say so).
ANTHROPIC_WORKSPACE_ID=

# Optional: narrate in your own voice. Put 1-2 minutes of your recording(s) in
# assets/voice/ and the voice is created on the first run, or set a voice id
# you already made at elevenlabs.io.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: X (Twitter) API v2 bearer token, Basic tier or above.
X_BEARER_TOKEN=

# YouTube Data API v3 (OAuth client of type "Desktop app").
# Run scripts/get_youtube_token.py once to get the refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Meta Graph API: one long-lived Page access token covers both the Facebook
# Page and the Instagram professional account linked to it.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0
